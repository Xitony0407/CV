---
import { getLangFromUrl, useTranslations } from "../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<main
  id="inicio"
  class="
    w-full overflow-hidden
    bg-[#020306]
    [background-image:radial-gradient(circle_at_73%_40%,rgba(91,31,190,0.18),transparent_35%)]
    max-[900px]:pt-[70px]
    max-[600px]:pt-[75px]
    max-[420px]:pt-[80px]
  "
>
  <div
    class="
      relative flex w-full items-start
      min-h-[clamp(680px,82vh,860px)]
      max-[1200px]:min-h-[700px]
      max-[900px]:min-h-0
      max-[900px]:flex-col
    "
  >

    <!-- TEXTO IZQUIERDO -->
    <section
      class="
        z-[5] w-[58%]
        pl-[clamp(25px,4vw,70px)]
        pt-[clamp(110px,14vh,160px)]

        max-[1200px]:w-[60%]
        max-[1200px]:pt-[120px]

        max-[900px]:w-full
        max-[900px]:px-[clamp(20px,6vw,50px)]
        max-[900px]:pt-[45px]
        max-[900px]:pb-[20px]

        max-[600px]:px-[20px]
        max-[600px]:pt-[35px]
        max-[600px]:pb-[15px]

        max-[420px]:px-[16px]
      "
    >

      <h1
        class="
          flex flex-col
          font-['Anton',sans-serif]
          uppercase
          leading-[0.95]
        "
      >

        <span
          class="
            text-[clamp(58px,8vw,120px)]
            tracking-[2px]
            text-transparent
            bg-clip-text
            bg-gradient-to-r
            from-[#7248e9]
            via-[#8671e4]
            to-[#da62da]

            max-[900px]:text-[clamp(58px,14vw,95px)]

            max-[600px]:text-[clamp(52px,17vw,78px)]
            max-[600px]:tracking-[1px]
          "
        >
          {t("hero.firstName")}
        </span>

        <span
          class="
            whitespace-nowrap
            text-[clamp(42px,5.8vw,88px)]
            tracking-[1px]
            text-white

            max-[1200px]:whitespace-normal

            max-[900px]:text-[clamp(40px,10vw,70px)]
            max-[900px]:whitespace-normal

            max-[600px]:text-[clamp(36px,11vw,56px)]
            max-[600px]:leading-none
          "
        >
          {t("hero.lastName")}
        </span>

      </h1>

      <div
        class="
          w-fit
          rotate-[-3deg]
          ml-[clamp(20px,5vw,90px)]
          mt-[clamp(10px,2vw,25px)]
          font-['Sacramento',cursive]
          text-[clamp(54px,6.5vw,100px)]
          text-[#9147e9]

          max-[900px]:ml-[5%]
          max-[900px]:text-[clamp(55px,12vw,85px)]

          max-[600px]:ml-[4%]
          max-[600px]:mt-[15px]
          max-[600px]:text-[clamp(50px,15vw,72px)]
        "
      >
        {t("hero.role")}
      </div>

      <div
        class="
          h-[2px]
          w-[min(95%,900px)]
          mt-[-10px]
          mb-[clamp(30px,4vw,50px)]
          bg-gradient-to-r
          from-[#8c2df2]
          via-[rgba(140,45,242,0.35)]
          to-transparent

          max-[600px]:w-full
          max-[600px]:mb-[28px]
        "
      ></div>

      <p
        class="
          font-normal
          text-[clamp(16px,1.9vw,29px)]
          leading-[1.35]
          text-white

          max-[900px]:text-[clamp(16px,3.3vw,24px)]

          max-[600px]:text-[clamp(15px,4.4vw,20px)]
          max-[600px]:leading-[1.4]

          max-[420px]:[&>br]:hidden
        "
      >
        {t("hero.description1")}<br />
        {t("hero.description2")}<br />
        {t("hero.description3")}
        <span class="text-[#9349e4]">
          {" "}
          {t("hero.university")}
        </span>
      </p>

    </section>

    <!-- FOTO -->
    <section
      class="
        absolute right-0 top-0
        flex h-full w-[52%]
        items-end justify-center
        overflow-visible

        max-[1200px]:w-[48%]

        max-[900px]:relative
        max-[900px]:right-auto
        max-[900px]:top-auto
        max-[900px]:min-h-[450px]
        max-[900px]:h-auto
        max-[900px]:w-full

        max-[600px]:min-h-[380px]
        max-[600px]:pt-[10px]

        max-[420px]:min-h-[330px]
      "
    >

      <img
  src={`${import.meta.env.BASE_URL}ximena.png`}
  alt="Ximena Gutiérrez Pérez"
  class="
    z-[3]
    h-[min(95%,820px)]
    w-auto
    max-w-full
    object-contain
    object-bottom

    max-[900px]:h-auto
    max-[900px]:w-[min(88%,520px)]
    max-[900px]:max-h-none

    max-[600px]:w-[min(95%,430px)]
  "
/>

    </section>

  </div>
</main>