        relative whitespace-nowrap
        text-[clamp(11px,0.85vw,14px)]
        font-medium
        text-white
        no-underline
        transition-colors duration-200

        after:absolute
        after:left-0
        after:bottom-[-8px]
        after:h-[2px]
        after:w-0
        after:bg-[#9747e8]
        after:transition-all
        after:duration-300

        hover:text-[#9747e8]
        hover:after:w-full

