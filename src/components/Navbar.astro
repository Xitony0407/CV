---
import { getLangFromUrl, useTranslations } from "../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

// Base del proyecto.
// Local: /
// GitHub Pages: /CV/
const base = import.meta.env.BASE_URL.replace(/\/$/, "");

const spanishUrl = `${base}/`;
const englishUrl = `${base}/en/`;
---

<nav
  class="
    fixed top-0 left-0 z-[1000]
    flex w-full items-center justify-between

    border-b border-[rgba(151,71,232,0.12)]

    bg-[rgba(2,3,6,0.9)]

    backdrop-blur-[12px]

    min-h-[70px]

    px-[clamp(20px,5vw,80px)]

    max-[900px]:min-h-[65px]
    max-[900px]:px-[25px]

    max-[650px]:min-h-0
    max-[650px]:flex-col
    max-[650px]:gap-[10px]
    max-[650px]:px-[15px]
    max-[650px]:py-[12px]

    max-[420px]:px-[10px]
    max-[420px]:py-[10px]
  "
>
  <!-- =========================
       SELECTOR DE IDIOMA
  ========================== -->
  <div
    class="
      flex shrink-0 items-center gap-[7px]
      text-[11px] font-medium
      tracking-[1px]

      max-[650px]:text-[10px]
    "
  >
    <a
      href={spanishUrl}
      class:list={[
        "no-underline transition-colors duration-200",
        lang === "es"
          ? "text-[#9747e8]"
          : "text-[#a9a9a9] hover:text-white",
      ]}
    >
      ES
    </a>

    <span class="text-[#555]">|</span>

    <a
      href={englishUrl}
      class:list={[
        "no-underline transition-colors duration-200",
        lang === "en"
          ? "text-[#9747e8]"
          : "text-[#a9a9a9] hover:text-white",
      ]}
    >
      EN
    </a>
  </div>

  <!-- =========================
       NAVEGACIÓN
  ========================== -->
  <div
    class="
      flex items-center

      gap-[clamp(18px,2.5vw,40px)]

      max-[900px]:gap-[20px]

      max-[650px]:w-full
      max-[650px]:flex-wrap
      max-[650px]:justify-center
      max-[650px]:gap-x-[18px]
      max-[650px]:gap-y-[10px]

      max-[420px]:gap-x-[12px]
      max-[420px]:gap-y-[8px]
    "
  >
    <!-- INICIO -->
    <a
      href="#inicio"
      class="
        relative whitespace-nowrap

        text-[clamp(11px,0.85vw,14px)]
        font-medium text-white no-underline

        transition-colors duration-200

        after:absolute
        after:left-0
        after:bottom-[-8px]
        after:h-[2px]
        after:w-0
        after:bg-[#9747e8]
        after:transition-all
        after:duration-300

        hover:text-[#9747e8]
        hover:after:w-full

        max-[900px]:text-[11px]

        max-[650px]:text-[10px]
        max-[650px]:after:bottom-[-4px]

        max-[420px]:text-[9px]
      "
    >
      {t("nav.home")}
    </a>

    <!-- QUÉ HAGO -->
    <a
      href="#que-hago"
      class="
        relative whitespace-nowrap

        text-[clamp(11px,0.85vw,14px)]
        font-medium text-white no-underline

        transition-colors duration-200

        after:absolute
        after:left-0
        after:bottom-[-8px]
        after:h-[2px]
        after:w-0
        after:bg-[#9747e8]
        after:transition-all
        after:duration-300

        hover:text-[#9747e8]
        hover:after:w-full

        max-[900px]:text-[11px]

        max-[650px]:text-[10px]
        max-[650px]:after:bottom-[-4px]

        max-[420px]:text-[9px]
      "
    >
      {t("nav.whatIDo")}
    </a>

    <!-- HABILIDADES -->
    <a
      href="#habilidades"
      class="
        relative whitespace-nowrap

        text-[clamp(11px,0.85vw,14px)]
        font-medium text-white no-underline

        transition-colors duration-200

        after:absolute
        after:left-0
        after:bottom-[-8px]
        after:h-[2px]
        after:w-0
        after:bg-[#9747e8]
        after:transition-all
        after:duration-300

        hover:text-[#9747e8]
        hover:after:w-full

        max-[900px]:text-[11px]

        max-[650px]:text-[10px]
        max-[650px]:after:bottom-[-4px]

        max-[420px]:text-[9px]
      "
    >
      {t("nav.skills")}
    </a>

    <!-- CONTACTO -->
    <a
      href="#contacto"
      class="
        relative whitespace-nowrap

        text-[clamp(11px,0.85vw,14px)]
        font-medium text-white no-underline

        transition-colors duration-200

        after:absolute
        after:left-0
        after:bottom-[-8px]
        after:h-[2px]
        after:w-0
        after:bg-[#9747e8]
        after:transition-all
        after:duration-300

        hover:text-[#9747e8]
        hover:after:w-full

        max-[900px]:text-[11px]

        max-[650px]:text-[10px]
        max-[650px]:after:bottom-[-4px]

        max-[420px]:text-[9px]
      "
    >
      {t("nav.contact")}
    </a>
  </div>
</nav>