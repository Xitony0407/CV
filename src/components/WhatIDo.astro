---
import { getLangFromUrl, useTranslations } from "../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const services = [
  {
    number: "01",
    title: t("service.web.title"),
    description: t("service.web.description"),
    image: "/CV/desarrollo-web.png",
  },
  {
    number: "02",
    title: t("service.backend.title"),
    description: t("service.backend.description"),
    image: "/CV/backend.png",
  },
  {
    number: "03",
    title: t("service.uiux.title"),
    description: t("service.uiux.description"),
    image: "/CV/uiux.png",
  },
  {
    number: "04",
    title: t("service.optimization.title"),
    description: t("service.optimization.description"),
    image: "/CV/optimizacion.png",
  },
];
---

<section
  id="que-hago"
  class="
    grid w-full items-start
    grid-cols-[minmax(360px,520px)_minmax(0,1fr)]
    gap-[clamp(30px,3vw,55px)]
    bg-[#020306]
    px-[clamp(25px,4vw,70px)]
    py-[clamp(55px,6vw,85px)]

    max-[1350px]:grid-cols-1
    max-[1350px]:gap-[40px]

    max-[950px]:px-[clamp(25px,5vw,45px)]
    max-[950px]:py-[55px]

    max-[600px]:gap-[30px]
    max-[600px]:px-[20px]
    max-[600px]:pt-[45px]
    max-[600px]:pb-[55px]

    max-[400px]:px-[16px]
  "
>

  <!-- INTRO -->
  <div
    class="
      min-w-0 w-full
      pl-[clamp(0px,3vw,70px)]

      max-[1350px]:max-w-[800px]
      max-[1350px]:pl-0
    "
  >

    <h2
      class="
        m-0
        mb-[clamp(28px,3vw,40px)]
        whitespace-nowrap
        font-['Anton',sans-serif]
        text-[clamp(40px,3.5vw,54px)]
        leading-none
        tracking-[0.5px]
        text-[#8c42e8]

        max-[600px]:mb-[25px]
        max-[600px]:whitespace-normal
        max-[600px]:text-[clamp(36px,11vw,44px)]
      "
    >
      {t("what.title")}
    </h2>

    <p
      class="
        mb-[clamp(25px,3vw,38px)]
        w-full
        max-w-[500px]
        text-[clamp(16px,1.15vw,18px)]
        leading-[1.6]
        text-white

        max-[1350px]:max-w-[700px]

        max-[600px]:mb-[25px]
        max-[600px]:max-w-full
        max-[600px]:text-[16px]
        max-[600px]:leading-[1.55]
      "
    >
      {t("what.description1")}
    </p>

    <p
      class="
        mb-[clamp(25px,3vw,38px)]
        w-full
        max-w-[500px]
        text-[clamp(16px,1.15vw,18px)]
        leading-[1.6]
        text-white

        max-[1350px]:max-w-[700px]

        max-[600px]:mb-[25px]
        max-[600px]:max-w-full
        max-[600px]:text-[16px]
        max-[600px]:leading-[1.55]
      "
    >
      {t("what.description2")}
    </p>

  </div>

  <!-- TARJETAS -->
  <div
    class="
      grid w-full
      grid-cols-4
      items-stretch
      gap-[clamp(14px,1.3vw,22px)]

      max-[950px]:grid-cols-2
      max-[950px]:gap-[20px]

      max-[600px]:grid-cols-1
      max-[600px]:gap-[18px]
    "
  >
    {
      services.map((service) => (
        <article
          class="
            relative
            flex w-full flex-col items-center
            overflow-hidden
            rounded-[11px]
            bg-[#11131a]
            px-[clamp(14px,1.5vw,20px)]
            pt-[clamp(28px,2vw,34px)]
            pb-[42px]
            text-center
            min-h-[clamp(360px,25vw,415px)]

            transition-all
            duration-300

            hover:-translate-y-[7px]
            hover:shadow-[0_0_25px_rgba(145,71,233,0.22)]

            max-[1350px]:min-h-[380px]

            max-[950px]:min-h-[370px]

            max-[600px]:min-h-[340px]
            max-[600px]:px-[20px]
            max-[600px]:pt-[30px]
            max-[600px]:pb-[42px]

            max-[400px]:min-h-[325px]
          "
        >

          <img
            src={service.image}
            alt={service.title}
            loading="lazy"
            class="
              mb-[clamp(18px,2vw,25px)]
              h-[clamp(58px,4vw,72px)]
              w-[clamp(58px,4vw,72px)]
              shrink-0
              object-contain

              max-[600px]:h-[65px]
              max-[600px]:w-[65px]
            "
          />

          <h3
            class="
              mb-[clamp(22px,2vw,30px)]
              flex min-h-[44px]
              w-full
              items-center
              justify-center
              text-[clamp(13px,1vw,15px)]
              font-medium
              leading-[1.45]
              text-white

              max-[600px]:mb-[20px]
              max-[600px]:text-[15px]
            "
          >
            {service.title}
          </h3>

          <p
            class="
              mx-auto
              w-full
              max-w-[180px]
              text-[clamp(13px,0.9vw,14px)]
              leading-[1.6]
              text-white

              max-[950px]:max-w-[220px]

              max-[600px]:max-w-[260px]
              max-[600px]:text-[14px]
            "
          >
            {service.description}
          </p>

          <span
            class="
              absolute
              bottom-[13px]
              left-[16px]
              text-[14px]
              text-[#9747e8]
            "
          >
            {service.number}
          </span>

        </article>
      ))
    }
  </div>

</section>