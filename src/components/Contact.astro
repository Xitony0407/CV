---
import { getLangFromUrl, useTranslations } from "../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<footer
  id="contacto"
  class="
    flex w-full items-start justify-between
    gap-[clamp(40px,6vw,100px)]
    border-b border-white/15
    bg-[#020306]
    px-[clamp(25px,5vw,90px)]
    py-[clamp(45px,5vw,70px)]

    max-[850px]:gap-[35px]
    max-[850px]:px-[35px]
    max-[850px]:py-[50px]

    max-[650px]:flex-col
    max-[650px]:gap-[45px]
    max-[650px]:px-[20px]
    max-[650px]:pt-[45px]
    max-[650px]:pb-[50px]

    max-[400px]:px-[16px]
  "
>

  <!-- INFORMACIÓN DE CONTACTO -->
  <div
    class="
      min-w-0 flex-1
      max-[650px]:w-full
    "
  >

    <h2
      class="
        mb-[clamp(22px,2.5vw,32px)]
        font-['Anton',sans-serif]
        text-[clamp(38px,3.5vw,52px)]
        leading-none
        tracking-[1px]
        text-[#8c42e8]

        max-[650px]:mb-[25px]
        max-[650px]:text-[clamp(36px,11vw,44px)]
      "
    >
      {t("contact.title")}
    </h2>

    <div
      class="
        flex flex-col
        gap-[clamp(10px,1vw,15px)]

        max-[650px]:gap-[14px]
      "
    >

      <a
        href="mailto:gutierrezperezximena4@gmail.com"
        class="
          flex w-fit max-w-full items-center
          gap-[12px]
          text-[clamp(14px,1.2vw,18px)]
          leading-[1.4]
          text-white
          no-underline
          transition-colors
          duration-200

          hover:text-[#9b4ded]

          max-[850px]:text-[15px]

          max-[650px]:w-full
          max-[650px]:items-start
          max-[650px]:text-[14px]

          max-[400px]:text-[13px]
        "
      >

        <span
          class="
            inline-flex w-[22px] shrink-0
            items-center justify-center
            text-[clamp(17px,1.5vw,21px)]

            max-[650px]:w-[20px]
            max-[650px]:text-[17px]
          "
        >
          ✉
        </span>

        <span class="min-w-0 [overflow-wrap:anywhere]">
          gutierrezperezximena4@gmail.com
        </span>

      </a>

      <a
        href="tel:+524778594499"
        class="
          flex w-fit max-w-full items-center
          gap-[12px]
          text-[clamp(14px,1.2vw,18px)]
          leading-[1.4]
          text-white
          no-underline
          transition-colors
          duration-200

          hover:text-[#9b4ded]

          max-[850px]:text-[15px]

          max-[650px]:w-full
          max-[650px]:items-start
          max-[650px]:text-[14px]

          max-[400px]:text-[13px]
        "
      >

        <span
          class="
            inline-flex w-[22px] shrink-0
            items-center justify-center
            text-[clamp(17px,1.5vw,21px)]

            max-[650px]:w-[20px]
            max-[650px]:text-[17px]
          "
        >
          ☎
        </span>

        <span class="min-w-0">
          477 859 4499
        </span>

      </a>

      <div
        class="
          flex w-fit max-w-full items-center
          gap-[12px]
          text-[clamp(14px,1.2vw,18px)]
          leading-[1.4]
          text-white

          max-[850px]:text-[15px]

          max-[650px]:w-full
          max-[650px]:items-start
          max-[650px]:text-[14px]

          max-[400px]:text-[13px]
        "
      >
      
      </div>

    </div>

  </div>

  <!-- REDES -->
  <div
    class="
      shrink-0
      max-[650px]:w-full
    "
  >

    <h2
      class="
        mb-[clamp(22px,2.5vw,32px)]
        font-['Anton',sans-serif]
        text-[clamp(38px,3.5vw,52px)]
        leading-none
        tracking-[1px]
        text-[#8c42e8]

        max-[650px]:mb-[25px]
        max-[650px]:text-[clamp(36px,11vw,44px)]
      "
    >
      {t("contact.connect")}
    </h2>

    <div
      class="
        flex items-center
        gap-[clamp(10px,1.2vw,15px)]

        max-[650px]:flex-wrap
        max-[650px]:gap-[12px]
      "
    >

      <a
        href="#"
        aria-label="GitHub"
        class="
          flex
          h-[clamp(54px,4.5vw,65px)]
          w-[clamp(54px,4.5vw,65px)]
          items-center
          justify-center
          rounded-[6px]
          bg-[#11131a]
          text-[clamp(16px,1.4vw,20px)]
          font-bold
          text-white
          no-underline
          transition-all
          duration-200

          hover:-translate-y-[5px]
          hover:bg-[#1b1e27]
          hover:shadow-[0_0_20px_rgba(145,71,233,0.18)]

          max-[850px]:h-[55px]
          max-[850px]:w-[55px]

          max-[650px]:h-[55px]
          max-[650px]:w-[55px]

          max-[400px]:h-[52px]
          max-[400px]:w-[52px]
        "
      >
        GH
      </a>

      <a
        href="#"
        aria-label="LinkedIn"
        class="
          flex
          h-[clamp(54px,4.5vw,65px)]
          w-[clamp(54px,4.5vw,65px)]
          items-center
          justify-center
          rounded-[6px]
          bg-[#11131a]
          font-[Arial,sans-serif]
          text-[clamp(34px,3vw,42px)]
          font-bold
          leading-none
          text-white
          no-underline
          transition-all
          duration-200

          hover:-translate-y-[5px]
          hover:bg-[#1b1e27]
          hover:shadow-[0_0_20px_rgba(145,71,233,0.18)]

          max-[850px]:h-[55px]
          max-[850px]:w-[55px]

          max-[650px]:h-[55px]
          max-[650px]:w-[55px]

          max-[400px]:h-[52px]
          max-[400px]:w-[52px]
        "
      >
        in
      </a>

      <a
        href="mailto:gutierrezperezximena4@gmail.com"
        aria-label="Correo"
        class="
          flex
          h-[clamp(54px,4.5vw,65px)]
          w-[clamp(54px,4.5vw,65px)]
          items-center
          justify-center
          rounded-[6px]
          bg-[#11131a]
          text-[clamp(30px,2.8vw,38px)]
          text-white
          no-underline
          transition-all
          duration-200

          hover:-translate-y-[5px]
          hover:bg-[#1b1e27]
          hover:shadow-[0_0_20px_rgba(145,71,233,0.18)]

          max-[850px]:h-[55px]
          max-[850px]:w-[55px]

          max-[650px]:h-[55px]
          max-[650px]:w-[55px]

          max-[400px]:h-[52px]
          max-[400px]:w-[52px]
        "
      >
        ✉
      </a>

    </div>

  </div>

</footer>